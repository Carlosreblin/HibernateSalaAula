<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Configurações do Banco de Dados (MySQL) -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/Bombeiro</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password"></property>

        <!-- Dialeto SQL para MySQL 8 -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- Exibe o SQL gerado no console e o formata -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Cria/Atualiza as tabelas automaticamente no banco -->
        <property name="hibernate.hbm2ddl.auto">update</property>
        
        <mapping class="com.mycompany.hibernatesalaaula.entities.Bombeiro" />
        <mapping class="com.mycompany.hibernatesalaaula.entities.Viatura" />
        <mapping class="com.mycompany.hibernatesalaaula.entities.StatusViatura" />
        <mapping class="com.mycompany.hibernatesalaaula.entities.AutoTanque" />
        <mapping class="com.mycompany.hibernatesalaaula.entities.UnidadeResgate" />
        <mapping class="com.mycompany.hibernatesalaaula.entities.AutoEscada" />
        <mapping class="com.mycompany.hibernatesalaaula.entities.Usuario" />
        <mapping class="com.mycompany.hibernatesalaaula.entities.TelefoneContato" />
        <mapping class="com.mycompany.hibernatesalaaula.entities.Patente" />
    </session-factory>
</hibernate-configuration>